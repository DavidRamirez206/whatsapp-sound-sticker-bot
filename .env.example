# Copy this file to ".env" (same folder as the bot) and edit the values you need.
# Every line is optional: the values shown are the defaults.

# Caption that triggers the bot. Send a video with this text as its caption.
COMMAND=!a

# Longest sticker in seconds. Longer videos are cut at this point.
MAX_SECONDS=25

# Upper bound for the number of frames. Fewer frames = less stutter on old phones.
MAX_FRAMES=250

# Opus bitrate of the sticker audio, in kbps.
AUDIO_KBPS=32

# Milliseconds skipped at the start of the audio. Raise it if the sound plays late
# compared to the animation, lower it (or set 0) if it plays early.
AUDIO_LEAD_MS=100

# How many videos are converted at the same time.
MAX_PARALLEL_JOBS=2

# 1 = the sticker is sent as a reply to the message that asked for it.
REPLY_TO_MESSAGE=1

# Folder holding the WhatsApp login. Treat it like a password.
SESSION_DIR=whatsapp_session

# Link with an 8-character pairing code instead of a QR code. Phone number with
# country code, digits only (e.g. 573001234567). Leave empty to use the QR code.
PAIRING_NUMBER=

# 1 = keep every received video and generated file in OUTPUTS_DIR (privacy: off by default).
SAVE_OUTPUTS=0
OUTPUTS_DIR=outputs
KEEP_OUTPUTS=15

# 1 = diagnostic mode: enables the test command, prints raw protocol messages,
# analyses incoming sound stickers and re-downloads every upload to verify it.
DEBUG=0
TEST_COMMAND=!t
VERIFY_UPLOAD=0

# Custom FFmpeg location (only if ffmpeg/ffprobe are not on PATH nor next to the executable).
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
